PORT=5000
NODE_ENV=development

# Comma-separated origins. In production, set this explicitly to the Vercel domain.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Microsoft Foundry project agent (recommended)
FOUNDRY_PROJECT_ENDPOINT=
TACTIQ_AGENT_NAME=

# Local Entra ID authentication: run `az login` before starting the backend.
# For a service principal, configure AZURE_TENANT_ID, AZURE_CLIENT_ID,
# and AZURE_CLIENT_SECRET in backend/.env instead.

# Alternative: direct Azure OpenAI deployment using an API key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-06-preview

# API-Football structured data provider
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
